# Rendered by the nginx image's envsubst step. No API proxy here: the API is
# served only on its own subdomain (api.<domain>). This container serves the
# SPA and nothing else: <domain>/auth, /health, /habits and /chat never reach
# the API and fall through to the SPA's index.html like any unknown path.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 10m;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_min_length 1024;

    # ---------- hashed assets: cache forever ----------
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ---------- SPA fallback ----------
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
