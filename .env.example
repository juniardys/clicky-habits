# ====== Clicky Habits - single root env ======
# This file is read by both apps (Bun loads it via --env-file) and by
# docker compose (env_file: .env) for local and Dokploy deployments.

# ---------------- required ----------------

# PostgreSQL connection string.
# Local:      postgresql://postgres@localhost:5432/clicky_habits
# Dokploy:    postgresql://user:pass@<db-host>:5432/clicky_habits
DATABASE_URL="postgresql://postgres@localhost:5432/clicky_habits"

# better-auth signing secret.
# Generate:   openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-random-32-char-secret"

# Public URL of the API / auth endpoints (better-auth baseURL).
# The API serves at its root: /auth/*, /health, /habits/*, /chat/*.
# Local dev:  http://localhost:5173        (Vite proxies those paths to :3001)
# Production: https://api.clickyhabits.com
BETTER_AUTH_URL="http://localhost:5173"

# ---------------- optional ----------------

# Extra allowed origins, comma-separated, no trailing slash.
# Localhost origins and the BETTER_AUTH_URL origin are always allowed.
# Setting this also enables credentialed CORS for these origins.
# Required in production: the web origin that calls the API subdomain.
# Production:  TRUSTED_ORIGINS="https://clickyhabits.com"
TRUSTED_ORIGINS=""

# Public API URL baked into the web bundle at build time
# (docker compose passes it as a build arg).
# Required in production: the web container has no route to the API.
# Empty = dev only (Vite proxy).
# Production:  VITE_API_URL="https://api.clickyhabits.com"
VITE_API_URL=""

# Google SSO (https://console.cloud.google.com/apis/credentials).
# Leave both empty to disable Google sign-in (email/password still works).
# Authorized redirect URI: <BETTER_AUTH_URL>/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# API server port inside its container.
PORT=3001

# LLM for the Mochi chat assistant (OpenAI-compatible, any provider)
# Example base URL: https://api.meta.ai/v1
# Leave API key / model empty to disable chat (UI shows "not configured").
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL=""
# "responses" -> POST {LLM_BASE_URL}/responses, "chat" -> POST {LLM_BASE_URL}/chat/completions
LLM_API_MODE="responses"
# Optional per-call LLM timeout in milliseconds (default 30000)
LLM_TIMEOUT_MS=""

# Host ports, used only by docker-compose.local.yml for local Docker testing.
# Production publishes no host ports: the reverse proxy (Dokploy's Traefik)
# routes <domain> -> web:80 and api.<domain> -> api:3001 over the Docker network.
APP_PORT=3000
API_PORT=3001
