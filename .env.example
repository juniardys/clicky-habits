# Clicky Habits env. Read by both apps (Bun --env-file) and docker compose.
# Format per var: what it does | local | production

# ---------------- Core (required) ----------------
# Postgres URL | localhost | postgresql://user:pass@<db-host>:5432/clicky_habits
DATABASE_URL="postgresql://postgres@localhost:5432/clicky_habits"
# better-auth secret, generate: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-random-32-char-secret"
# Public API/auth URL | http://localhost:5173 (Vite proxy) | https://api.clickyhabits.com
BETTER_AUTH_URL="http://localhost:5173"
# API port inside container
PORT=3001

# ---------------- Web / CORS ----------------
# Extra allowed origins, comma-separated | "" | "https://clickyhabits.com" (required, API exits if empty)
TRUSTED_ORIGINS=""
# API URL baked into web build | "" (Vite proxy) | "https://api.clickyhabits.com" (required)
VITE_API_URL=""

# ---------------- Google SSO (empty = disabled) ----------------
# Redirect URI: <BETTER_AUTH_URL>/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Same client ID, baked into web build for One Tap (rebuild on change).
# Add web origins (localhost:5173, clickyhabits.com) to Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=""

# ---------------- Email / SMTP (empty host = log emails to console) ----------------
# Host | "" | "smtp.gmail.com" (or Mailgun, SES, Brevo)
SMTP_HOST=""
# 587 + SECURE=false (STARTTLS), or 465 + SECURE=true (TLS). Default 587 / false.
SMTP_PORT="587"
SMTP_SECURE="false"
# Login, empty if no auth | "" | "you@gmail.com" + app password
SMTP_USER=""
SMTP_PASS=""
# Sender | "" (= Clicky Habits <no-reply@localhost>) | "Clicky Habits <no-reply@clickyhabits.com>"
EMAIL_FROM=""

# ---------------- LLM / Mochi chat (empty key or model = disabled) ----------------
# OpenAI-compatible base URL, e.g. https://api.meta.ai/v1
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL=""
# "responses" (POST /responses) or "chat" (POST /chat/completions)
LLM_API_MODE="responses"
# Per-call timeout in ms, default 30000
LLM_TIMEOUT_MS=""
