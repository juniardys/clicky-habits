# ====== Clicky Habits - single root env ======
# This file is read by both apps (Bun loads it via --env-file) and by
# docker compose (env_file: .env) for local and Dokploy deployments.

# ---------------- required ----------------

# PostgreSQL connection string.
# Local:      postgresql://postgres@localhost:5432/clicky_habits
# Dokploy:    postgresql://user:pass@<db-host>:5432/clicky_habits
DATABASE_URL="postgresql://postgres@localhost:5432/clicky_habits"

# better-auth signing secret.
# Generate:   openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-random-32-char-secret"

# Public URL of the API / auth endpoints (better-auth baseURL).
# The API serves at its root: /auth/*, /health, /habits/*, /chat/*.
# Local dev:  http://localhost:5173        (Vite proxies those paths to :3001)
# Production: https://api.clickyhabits.com
BETTER_AUTH_URL="http://localhost:5173"

# ---------------- optional ----------------

# Extra allowed origins, comma-separated, no trailing slash.
# Localhost origins and the BETTER_AUTH_URL origin are always allowed.
# Setting this also enables credentialed CORS for these origins.
# Required in production: the web origin that calls the API subdomain.
# If empty, the API logs a [config] error at boot and, with
# NODE_ENV=production, exits instead of starting.
# Production:  TRUSTED_ORIGINS="https://clickyhabits.com"
TRUSTED_ORIGINS=""

# Public API URL baked into the web bundle at build time
# (docker compose passes it as a build arg).
# Required in production: the web container has no route to the API.
# Empty = dev only (Vite proxy).
# Production:  VITE_API_URL="https://api.clickyhabits.com"
VITE_API_URL=""

# Google SSO (https://console.cloud.google.com/apis/credentials).
# Leave both empty to disable Google sign-in (email/password still works).
# Authorized redirect URI: <BETTER_AUTH_URL>/auth/callback/google
# Signing in always shows the Google account picker (prompt=select_account).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Same Google OAuth client ID as GOOGLE_CLIENT_ID, baked into the web bundle
# at build time (docker compose passes it as a build arg) for Google One Tap:
# the floating "Continue as ..." prompt on the login page. It is a public
# identifier, not a secret. Empty = One Tap prompt disabled; the regular
# Google button is unaffected. Changing it requires a web rebuild.
# One Tap also needs every web origin that shows the prompt registered in
# Google Cloud Console (APIs & Services > Credentials > OAuth client >
# Authorized JavaScript origins), e.g.:
#   Local:      http://localhost:5173
#   Production: https://clickyhabits.com
# Production:  VITE_GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID=""

# Email (SMTP) for account emails: verification link at sign-up, resend
# from the "verify your email" banner, and confirming an email change.
# Leave SMTP_HOST empty to send nothing and print each email (with its link)
# to the API console instead. Fine for local dev, not for production.
# Local:       SMTP_HOST=""   (links show up in the API logs)
# Production:  SMTP_HOST="smtp.gmail.com" (or Mailgun, SES, Brevo, ...)
SMTP_HOST=""
# SMTP port. 587 = STARTTLS (use SMTP_SECURE=false), 465 = TLS (SMTP_SECURE=true).
# Empty = 587. Ignored while SMTP_HOST is empty.
# Local:       SMTP_PORT="587"
# Production:  SMTP_PORT="587" (or "465" with SMTP_SECURE="true")
SMTP_PORT="587"
# "true" for implicit TLS (port 465), "false" otherwise. Empty = false.
# Local:       SMTP_SECURE="false"
# Production:  SMTP_SECURE="false" for 587, "true" for 465
SMTP_SECURE="false"
# SMTP login user. Leave empty if the server needs no auth.
# Local:       SMTP_USER=""
# Production:  SMTP_USER="you@gmail.com" (or the provider's SMTP username)
SMTP_USER=""
# SMTP login password. Only used when SMTP_USER is set.
# Local:       SMTP_PASS=""
# Production:  SMTP_PASS="app-password" (Gmail app password or provider key)
SMTP_PASS=""
# Sender shown to users. Must be allowed by the SMTP provider.
# Empty = "Clicky Habits <no-reply@localhost>".
# Local:       EMAIL_FROM=""
# Production:  EMAIL_FROM="Clicky Habits <no-reply@clickyhabits.com>"
EMAIL_FROM=""

# API server port inside its container.
PORT=3001

# LLM for the Mochi chat assistant (OpenAI-compatible, any provider)
# Example base URL: https://api.meta.ai/v1
# Leave API key / model empty to disable chat (UI shows "not configured").
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL=""
# "responses" -> POST {LLM_BASE_URL}/responses, "chat" -> POST {LLM_BASE_URL}/chat/completions
LLM_API_MODE="responses"
# Optional per-call LLM timeout in milliseconds (default 30000)
LLM_TIMEOUT_MS=""
