# ====== Clicky Habits - single root env ======
# Works for local dev as-is. For production (Dokploy, subdomain setup),
# see the "Prod (api.clickyhabits.com)" comments on each var.

# PostgreSQL
DATABASE_URL="postgresql://postgres@localhost:5432/clicky_habits"
# Prod: postgresql://user:pass@host:5432/clicky_habits (managed DB / Dokploy DB service)

# better-auth
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-random-32-char-secret"

# Public URL of the auth/API endpoints.
# Dev: the web dev server (it proxies /api to the API on :3001).
BETTER_AUTH_URL="http://localhost:5173"
# Prod (api.clickyhabits.com): BETTER_AUTH_URL="https://api.clickyhabits.com"

# Origins allowed to call the API (CSRF + CORS, comma-separated, no trailing slash).
# Dev: not needed (same origin via Vite proxy).
# Prod: BETTER_AUTH_TRUSTED_ORIGINS="https://clickyhabits.com"
#       CORS_ORIGINS="https://clickyhabits.com"
BETTER_AUTH_TRUSTED_ORIGINS=""
CORS_ORIGINS=""

# Web build only - baked into the bundle at `bun run build:web`.
# Dev: leave empty (Vite proxy handles /api).
VITE_API_URL=""
# Prod (api.clickyhabits.com): VITE_API_URL="https://api.clickyhabits.com"

# Google SSO (https://console.cloud.google.com/apis/credentials)
# Dev redirect URI:  http://localhost:5173/api/auth/callback/google
# Prod redirect URI: https://api.clickyhabits.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# API server port (Dokploy: must match the port configured on the api service)
PORT=3001
