{
  "name": "@clicky/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --hot src/index.ts",
    "start": "bun src/index.ts",
    "db:migrate": "dotenv -e ../../.env -- bunx prisma migrate dev",
    "db:migrate:deploy": "bunx prisma migrate deploy",
    "db:generate": "bunx prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "better-auth": "^1.3.26",
    "hono": "^4.9.9"
  },
  "devDependencies": {
    "@types/bun": "^1.2.22",
    "dotenv-cli": "^11.1.0",
    "prisma": "^6.16.2"
  }
}
