{
  "name": "@clicky/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --hot src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "db:migrate": "dotenv -e ../../.env -- bunx prisma migrate dev --skip-seed",
    "db:migrate:deploy": "bunx prisma migrate deploy",
    "db:generate": "bunx prisma generate",
    "db:reset": "dotenv -e ../../.env -- bunx prisma migrate reset --skip-seed",
    "db:reset:force": "dotenv -e ../../.env -- bunx prisma migrate reset --force --skip-seed",
    "db:seed": "dotenv -e ../../.env -- bunx prisma db seed"
  },
  "prisma": {
    "seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "better-auth": "^1.3.26",
    "hono": "^4.9.9",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.22",
    "@types/nodemailer": "^8.0.2",
    "dotenv-cli": "^11.1.0",
    "prisma": "^6.16.2"
  }
}
